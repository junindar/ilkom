@page "/home4"
@using ComputerVisionIntro.Service
@using ComputerVisionIntro.Helper
@using ComputerVisionIntro.Models
@inject IComputerVisionService VisionService

@using System.Text.RegularExpressions


<div class="container py-4" style="max-width:700px;">
    <!-- Header -->
    <div class="text-center mb-4">
        <div style="font-size:48px; margin-bottom:8px;">&#129534;</div>
        <h2 style="font-weight:700; color:#0d6efd; margin-bottom:4px;">Scan Struk Belanja</h2>
        <p class="text-muted" style="font-size:0.9rem;">OCR cerdas untuk membaca struk belanja menggunakan Azure AI</p>
    </div>

    <!-- Upload Area -->
    <div class="card border-0 shadow" style="border-radius:16px; overflow:hidden;">
        <div class="card-body p-4 text-center">
            <div style="border:2px dashed #c5ccd6; border-radius:12px; padding:36px 24px; background:linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                <div style="font-size:40px; margin-bottom:12px; opacity:0.8;">&#128196;</div>
                <p style="color:#6c757d; font-size:0.95rem; margin-bottom:16px;">
                    Pilih foto struk belanja untuk dianalisis
                </p>
                <InputFile OnChange="OnFileSelected" accept="image/*"
                           class="form-control mx-auto" style="max-width:320px; border-radius:50px;" disabled="@IsLoading" />
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    @if (IsLoading)
    {
        <div class="text-center mt-4 py-3">
            <div class="spinner-border text-primary" style="width:2.5rem; height:2.5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-3" style="font-size:0.95rem;">Membaca struk dengan OCR...</p>
        </div>
    }

    <!-- Image Preview -->
    @if (ImagePreview != null)
    {
        <div class="card border-0 shadow-sm mt-4" style="border-radius:16px; overflow:hidden;">
            <div class="card-body p-4 text-center">
                <div class="d-flex align-items-center mb-3">
                    <span style="font-size:22px; margin-right:10px;">&#128248;</span>
                    <h5 style="font-weight:600; color:#212529; margin:0;">Preview Struk</h5>
                </div>
                <img src="@ImagePreview"
                     style="max-width:100%; max-height:320px; border-radius:12px; box-shadow:0 4px 16px rgba(0,0,0,0.1); object-fit:contain;" />
            </div>
        </div>
    }

    <!-- OCR Results -->
    @if (Lines != null)
    {
        <!-- Merchant Info Cards -->
        <div class="card border-0 shadow-sm mt-4" style="border-radius:16px; overflow:hidden;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <span style="font-size:22px; margin-right:10px;">&#128202;</span>
                    <h5 style="font-weight:600; color:#212529; margin:0;">Informasi Struk</h5>
                </div>
                <hr style="opacity:0.1;" />

                <div class="row g-3">
                    <div class="col-4">
                        <div style="background:#f0f4ff; border-radius:12px; padding:16px; text-align:center;">
                            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#6c757d; margin-bottom:6px;">Merchant</div>
                            <div style="font-weight:600; color:#212529; font-size:0.95rem;">@(Merchant ?? "-")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="background:#f0faf0; border-radius:12px; padding:16px; text-align:center;">
                            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#6c757d; margin-bottom:6px;">Tanggal</div>
                            <div style="font-weight:600; color:#212529; font-size:0.95rem;">@(Date ?? "-")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div style="background:#fff8f0; border-radius:12px; padding:16px; text-align:center;">
                            <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:#6c757d; margin-bottom:6px;">Total</div>
                            <div style="font-weight:700; color:#198754; font-size:1.05rem;">@(Total ?? "-")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="card border-0 shadow-sm mt-4" style="border-radius:16px; overflow:hidden;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <span style="font-size:22px; margin-right:10px;">&#128203;</span>
                    <h5 style="font-weight:600; color:#212529; margin:0;">Detail Item</h5>
                </div>
                <hr style="opacity:0.1;" />

                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="font-size:0.9rem;">
                        <thead>
                            <tr style="background:#f8f9fa; border-bottom:2px solid #dee2e6;">
                                <th style="font-weight:600; color:#495057; padding:12px 8px;">No</th>
                                <th style="font-weight:600; color:#495057; padding:12px 8px;">Nama Item</th>
                                <th class="text-end" style="font-weight:600; color:#495057; padding:12px 8px;">Harga</th>
                                <th class="text-center" style="font-weight:600; color:#495057; padding:12px 8px;">Qty</th>
                                <th class="text-end" style="font-weight:600; color:#495057; padding:12px 8px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr style="border-bottom:1px solid #f0f0f0;">
                                    <td style="padding:10px 8px; color:#6c757d;">@item.No</td>
                                    <td style="padding:10px 8px; font-weight:500;">@item.Nama</td>
                                    <td class="text-end" style="padding:10px 8px;">@item.Harga.ToString("N0")</td>
                                    <td class="text-center" style="padding:10px 8px;">@item.Jumlah</td>
                                    <td class="text-end" style="padding:10px 8px; font-weight:500;">@item.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top:2px solid #dee2e6;">
                                <td colspan="4" class="text-end" style="padding:10px 8px; font-weight:600; color:#495057;">Sub Total</td>
                                <td class="text-end" style="padding:10px 8px; font-weight:600;">@subTotal.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end" style="padding:10px 8px; font-weight:600; color:#495057;">Pajak (10%)</td>
                                <td class="text-end" style="padding:10px 8px; font-weight:600;">@pajak.ToString("N0")</td>
                            </tr>
                            <tr style="background:linear-gradient(135deg, #d1e7dd 0%, #badbcc 100%); border-radius:8px;">
                                <td colspan="4" class="text-end" style="padding:14px 8px; font-weight:700; color:#0f5132; font-size:1rem;">Total Bayar</td>
                                <td class="text-end" style="padding:14px 8px; font-weight:700; color:#0f5132; font-size:1.1rem;">@total.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<string>? Lines;
    private string? Total;
    private string? Date;
    private string? Merchant;
    private string? ImagePreview;
    private bool IsLoading;

    List<ReceiptItem> items = new();

    int subTotal;
    int pajak;
    int total;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        IsLoading = true;
        Lines = null;
        ImagePreview = null;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream();
            var result = await VisionService.AnalyzeReceiptAsync(stream);

            Lines = result.Lines;
            Total = result.Total;
            Date = result.Date;
            Merchant = result.Merchant;

            items.Clear();
            ParseItems();

            subTotal = ExtractValue("sub");
            pajak = ExtractValue("pajak");
            total = ExtractValue("total");

            ImagePreview = $"data:image/png;base64,{Convert.ToBase64String(result.ImageData)}";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private void ParseItems()
    {
        int no = 1;
        for (int i = 0; i < Lines.Count; i++)
        {
            string line = Lines[i].Trim();

            if (TryParseCase1(line, ref i, ref no)) continue;
            if (TryParseCase2(i, ref i, ref no)) continue;
        }
    }


    private bool TryParseCase1(string line, ref int i, ref int no)
    {
        if (!Regex.IsMatch(line, @"^\d+\s+.+")) return false;

        var parts = line.Split(' ', 2);
        int qty = int.Parse(parts[0]);
        string nama = parts[1];

        if (i + 1 < Lines.Count && MyHelper.IsPrice(Lines[i + 1]))
        {
            double harga = double.Parse(MyHelper.Normalize(Lines[i + 1])) / qty;
            items.Add(new ReceiptItem { No = no++, Nama = nama, Harga = harga, Jumlah = qty });
            i++;
        }
        return true;
    }


    private bool TryParseCase2(int index, ref int i, ref int no)
    {
        if (!int.TryParse(Lines[index].Trim(), out int jumlah)) return false;
        if (index + 2 >= Lines.Count || !MyHelper.IsPrice(Lines[index + 2])) return false;

        string nama = Lines[index + 1].Trim();
        double harga = double.Parse(MyHelper.Normalize(Lines[index + 2])) / jumlah;
        items.Add(new ReceiptItem { No = no++, Nama = nama, Harga = harga, Jumlah = jumlah });
        i += 2;
        return true;
    }

    private int ExtractValue(string keyword)
    {
        for (int i = 0; i < Lines.Count; i++)
        {
            string line = Lines[i].Trim().ToLower();
            if (!line.Contains(keyword)) continue;


            if (i + 1 < Lines.Count && MyHelper.IsNumber(Lines[i + 1]))
                return int.Parse(MyHelper.Normalize(Lines[i + 1]));


            var match = Regex.Match(Lines[i], @"([\d.,]+)$");
            if (match.Success) return int.Parse(MyHelper.Normalize(match.Value));
        }
        return 0;
    }

   
}
