@page "/"
@using ComputerVisionIntro.Service
@using ComputerVisionIntro.Helper
@inject IComputerVisionService VisionService

<div class="container py-4" style="max-width:600px;">
    <!-- Header -->
    <div class="text-center mb-4">
        <div style="font-size:48px; margin-bottom:8px;">&#129504;</div>
        <h2 style="font-weight:700; color:#0d6efd; margin-bottom:4px;">Azure Computer Vision</h2>
        <p class="text-muted" style="font-size:0.9rem;">Analisis cerdas gambar menggunakan Azure AI &mdash; Blazor Hybrid</p>
    </div>

    <!-- Upload Area -->
    <div class="card border-0 shadow" style="border-radius:16px; overflow:hidden;">
        <div class="card-body p-4 text-center">
            @if (string.IsNullOrEmpty(ImagePreview))
            {
                <div style="border:2px dashed #c5ccd6; border-radius:12px; padding:48px 24px; background:linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
                    <div style="font-size:56px; margin-bottom:16px; opacity:0.8;">&#128247;</div>
                    <p style="color:#6c757d; font-size:1rem; margin-bottom:20px;">
                        Unggah gambar untuk dianalisis oleh AI
                    </p>
                    <button class="btn btn-primary btn-lg px-5 py-2"
                            style="border-radius:50px; font-weight:600; box-shadow:0 4px 14px rgba(13,110,253,0.3);"
                            @onclick="PickImage" disabled="@IsLoading">
                        &#128194; Pilih Gambar
                    </button>
                </div>
            }
            else
            {
                <div style="position:relative; margin-bottom:20px;">
                    <img src="@ImagePreview"
                         style="max-width:100%; max-height:320px; border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,0.12); object-fit:contain;" />
                </div>
                <button class="btn btn-outline-primary px-4 py-2"
                        style="border-radius:50px; font-weight:500;"
                        @onclick="PickImage" disabled="@IsLoading">
                    &#128260; Ganti Gambar
                </button>
            }
        </div>
    </div>

    <!-- Loading Indicator -->
    @if (IsLoading)
    {
        <div class="text-center mt-4 py-3">
            <div class="spinner-border text-primary" style="width:2.5rem; height:2.5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-3" style="font-size:0.95rem;">Menganalisis gambar dengan AI...</p>
        </div>
    }

    <!-- Result Card -->
    @if (!string.IsNullOrEmpty(Description))
    {
        <div class="card border-0 shadow-sm mt-4" style="border-radius:16px; border-left:4px solid #0d6efd !important; overflow:hidden;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <span style="font-size:24px; margin-right:10px;">&#128161;</span>
                    <h5 style="font-weight:700; color:#212529; margin:0;">Hasil Analisis</h5>
                </div>
                <hr style="opacity:0.15;" />
                <p style="font-size:1.05rem; line-height:1.7; color:#495057; margin-bottom:0;">
                    @Description
                </p>
            </div>
        </div>
    }
</div>

@code {
    private string? ImagePreview;
    private string? Description;
    private bool IsLoading;

    private async Task PickImage()
    {
        Description = null;

        var file = await FilePickerHelper.PickImageAsync();
        if (file == null)
            return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            ImagePreview = await FileHelper.ToBase64ImageAsync(file);
            Description = await VisionService.AnalyzeImageAsync(file);
        }
        finally
        {
            IsLoading = false;
        }
    }
}