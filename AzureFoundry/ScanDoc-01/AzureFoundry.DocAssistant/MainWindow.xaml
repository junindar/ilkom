<Window x:Class="AzureFoundry.DocAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:AzureFoundry.DocAssistant.Components"
        Title="Document Assistant" Height="720" Width="1080">
    <Grid>
        <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html"
                               Services="{DynamicResource ServiceProvider}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                       ComponentType="{x:Type components:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
